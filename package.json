{
  "name": "metromorph",
  "version": "1.0.0",
  "description": "Metromorph - phrased tuplets after Malcolm Braff's General Theory of Rhythm",
  "main": "electron/main.js",
  "author": "@jassdudek",
  "license": "UNLICENSED",
  "scripts": {
    "electron": "electron .",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist:mac-intel": "electron-builder --mac --x64 --publish never",
    "dist:mac-arm": "electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@capacitor/assets": "^3.0.5"
  },
  "build": {
    "appId": "com.metromorph.app",
    "productName": "Metromorph",
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}